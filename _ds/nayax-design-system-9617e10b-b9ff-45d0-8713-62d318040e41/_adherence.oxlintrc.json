        "selector": "JSXOpeningElement[name.name='Loading2'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Loading2> doesn't accept that prop. Declared props: className, style."
