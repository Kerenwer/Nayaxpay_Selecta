{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/**",
              "icons/**",
              "promotion/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hurme Geometric Sans 3|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Hurme Geometric Sans 3, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Add'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Add> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|direction|state|key|ref|className|style|children)$/]",
        "message": "<Arrow> doesn't accept that prop. Declared props: className, style, direction, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<Arrow> direction must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover)$/]",
        "message": "<Arrow> state must be one of 'default' | 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ArrowRight> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight2'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ArrowRight2> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|iconLead|breakpoint|l|kind|t|state|iconTail|size|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, iconLead, breakpoint, l, kind, t, state, iconTail, size, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<Button> breakpoint must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:highlight|primary|secondary)$/]",
        "message": "<Button> kind must be one of 'highlight' | 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:enabled|focused|hover|disabled|loading)$/]",
        "message": "<Button> state must be one of 'enabled' | 'focused' | 'hover' | 'disabled' | 'loading'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|s)$/]",
        "message": "<Button> size must be one of 'l' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChevronDown'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ChevronDown> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|color|spacing|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: className, style, color, spacing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:base|subdued)$/]",
        "message": "<Divider> color must be one of 'base' | 'subdued'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='spacing'] > Literal[value!=/^(?:0px|8px|16 px)$/]",
        "message": "<Divider> spacing must be one of '0px' | '8px' | '16 px'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Download16'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Download16> doesn't accept that prop. Declared props: className, style."
      },
