        "message": "<Footer> doesn't accept that prop. Declared props: className, style, breakpoint, state, text1, text2, text3, text4, icon1, icon2, icon3, icon4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<Footer> breakpoint must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|error|success)$/]",
        "message": "<Footer> state must be one of 'default' | 'error' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Help24'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|isBold|text1|key|ref|className|style|children)$/]",
        "message": "<Help24> doesn't accept that prop. Declared props: className, style, isBold, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|iconLead|breakpoint|l|size|t|iconTail|state|text1|key|ref|className|style|children)$/]",
        "message": "<Link> doesn't accept that prop. Declared props: className, style, iconLead, breakpoint, l, size, t, iconTail, state, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<Link> breakpoint must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|s)$/]",
        "message": "<Link> size must be one of 'l' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:enabled|hover|visited|disabled)$/]",
        "message": "<Link> state must be one of 'enabled' | 'hover' | 'visited' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loading'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Loading> doesn't accept that prop. Declared props: className, style."
      },
