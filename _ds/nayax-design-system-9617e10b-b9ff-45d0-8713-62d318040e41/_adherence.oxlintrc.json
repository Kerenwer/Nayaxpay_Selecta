        "message": "<Overlay> doesn't accept that prop. Declared props: className, style, breakpoint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overlay'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:all \\(xs-xxl\\)|mobile \\(xs-s\\))$/]",
        "message": "<Overlay> breakpoint must be one of 'all (xs-xxl)' | 'mobile (xs-s)'."
